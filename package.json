{
  "name": "azuracast-player",
  "version": "1.0.0",
  "description": "SPA audio player for the streaming stations provided by AzuraCast.",
  "scripts": {
    "dev": "cross-env webpack serve --mode development --open",
    "dev:watch": "cross-env webpack --mode development --watch",
    "build": "cross-env webpack --mode production --progress",
    "sass-min": "sass ./src/scss:./public/css --style compressed",
    "init": "live-server --open=.",
    "serve": "http-server . -p 8484 -a localhost"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:PeWe79/AzuraCast-Player-Main.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PeWe79/AzuraCast-Player-Main/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "clean-css": "^5.3.3",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "ignore-loader": "^0.1.2",
    "jsonp": "^0.2.1",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.1.1",
    "sass": "^1.82.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-obfuscator": "^3.5.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "http-server": "^14.1.1",
    "three": "^0.180.0",
    "vue": "^3.5.22"
  }
}
